# Neon Postgres connection string (eu-central-1 / Frankfurt)
DATABASE_URL="postgresql://neondb_owner:your-password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Managed Better Auth — get NEON_AUTH_BASE_URL from Neon Console:
# your project → Auth → Configuration tab (NOT the same as DATABASE_URL)
NEON_AUTH_BASE_URL=""
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# NOTE: Google OAuth Client ID/Secret are NOT set here — Managed Better
# Auth is a hosted service, so Google sign-in is configured directly in
# the Neon Console (Auth → Configuration → Google provider), not via env
# vars in this app. If you already pasted them into your local .env
# earlier, they're unused now — the real place is the Neon dashboard.

# Cloudflare R2 (exercise GIF storage) — set up later
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Google Sheets sync (n8n reads/writes using these)
GOOGLE_SHEETS_EXERCISE_SHEET_ID="1o_Tax3WO-1Ks7Oq-8WISymZq8Xsxx9gADTlXw1enV74"
