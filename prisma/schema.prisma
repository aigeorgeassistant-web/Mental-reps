// mental-reps — Prisma schema
// See ../SPEC.md section 12 for the plain-English summary of this model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Units {
  KG
  LB
}

enum LoadType {
  FIXED
  PERCENTAGE
  RELATIVE
}

enum SetType {
  FIXED_REPS
  REP_RANGE
  AMRAP
  TIME
  DISTANCE
  CALORIES
}

enum ExerciseSource {
  SHEET
  APP_QUICK_ADD
}

// One per human coach (George, his wife). Linked to a Better Auth user
// (id lives in the neon_auth schema, managed by Better Auth itself).
model Coach {
  id         String   @id @default(cuid())
  authUserId String   @unique
  name       String
  email      String   @unique
  createdAt  DateTime @default(now())

  clients  Client[]
  programs Program[]
  bundles  Bundle[]
}

// A coach's client. Notes are split per SPEC.md §5 — Health/mobility notes
// are the ONLY field the AI warning system (§11) is allowed to read.
model Client {
  id            String   @id @default(cuid())
  coachId       String
  coach         Coach    @relation(fields: [coachId], references: [id])
  authUserId    String?  @unique
  name          String
  email         String
  phone         String?
  healthNotes   String?
  generalNotes  String?
  equipment     String[]
  units         Units    @default(KG)
  createdAt     DateTime @default(now())

  programs          Program[]
  loggedSets        LoggedSet[]
  invites           ClientInvite[]
  templatePurchases TemplatePurchase[]
  checkIns          CheckIn[]
  exercisePrs       ExercisePr[]
  bundlePurchases   BundlePurchase[]
}

// The shared exercise catalog.
model Exercise {
  id              String         @id @default(cuid())
  name            String         @unique
  gifUrl          String?
  youtubeUrl      String?
  cues            String?
  muscleGroups    String[]
  equipment       String[]
  lowerIsBetter   Boolean        @default(false)
  source          ExerciseSource @default(SHEET)
  createdAt       DateTime       @default(now())

  sessionExercises SessionExercise[]
  loggedSets       LoggedSet[]
  exercisePrs      ExercisePr[]
}

// A reusable template (isTemplate=true) OR a live client program.
model Program {
  id          String   @id @default(cuid())
  coachId     String
  coach       Coach    @relation(fields: [coachId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  name        String
  isTemplate  Boolean  @default(false)
  price       Decimal?
  currency    String?  @default("KWD")
  category    String?
  description String?
  isPublished     Boolean   @default(false)
  discountFlat    Decimal?
  discountPercent Decimal?
  discountEndsAt  DateTime?
  createdAt       DateTime  @default(now())

  sessions          Session[]
  templatePurchases TemplatePurchase[]
  bundleItems       BundleItem[]
}

// One "day" within a Program.
model Session {
  id         String    @id @default(cuid())
  programId  String
  program    Program   @relation(fields: [programId], references: [id])
  date       DateTime?
  weekNumber Int?
  dayLabel   String
  order      Int       @default(0)

  sessionExercises SessionExercise[]
  loggedSets       LoggedSet[]
  checkIn          CheckIn?
}

// One exercise placed within a Session.
model SessionExercise {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int      @default(0)

  sets      Int?
  reps      Int?
  setType   SetType  @default(FIXED_REPS)
  loadType  LoadType @default(FIXED)
  loadValue Float?
  loadUnit  Units?
  coachNote String?
  target    String?

  groupId    String?
  groupColor String?

  isRandomizerSlot    Boolean  @default(false)
  slotPoolExerciseIds String[]

  rpeEnabled  Boolean @default(false)
  restSeconds Int?
  clientNote  String?

  loggedSets LoggedSet[]
}

// Actual client-entered history. One row per set per exercise per session.
// sessionExerciseId + setIndex is unique — upsert overwrites on re-log.
// notes field stores client's per-set note (coach-visible, AI-readable).
model LoggedSet {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  exerciseId        String
  exercise          Exercise @relation(fields: [exerciseId], references: [id])
  sessionId         String?
  session           Session? @relation(fields: [sessionId], references: [id])
  sessionExerciseId String?
  sessionExercise   SessionExercise? @relation(fields: [sessionExerciseId], references: [id])
  setIndex          Int      @default(0)
  date              DateTime @default(now())
  weight            Float?
  reps              Int?
  distance          Float?
  duration          Int?
  notes             String?
  rpe               Float?
  isPr              Boolean  @default(false)

  @@unique([sessionExerciseId, setIndex])
}

// Cached "current best" per client+exercise, so PR detection on every log
// is a single row lookup instead of scanning all of a client's history.
// Rewritten by app/api/client/log-set on every new PR. loggedSetId is a
// plain pointer (no FK) so it never blocks a LoggedSet cascade-delete —
// only clientId/exerciseId are enforced relations here.
model ExercisePr {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  loggedSetId String?
  bestWeight  Float?
  bestReps    Int?
  bestE1rm    Float?
  updatedAt   DateTime @updatedAt

  @@unique([clientId, exerciseId])
}

// Invite tokens sent to clients so they can link their Google account.
model ClientInvite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// Template purchases — tracks which client bought or was granted which template.
// grantedBy: coachId if granted for free by a coach, null if purchased via Paddle.
model TemplatePurchase {
  id          String   @id @default(cuid())
  templateId  String
  clientId    String
  purchasedAt DateTime @default(now())
  pricePaid   Decimal
  currency    String
  grantedBy   String?  // coachId — set when coach grants for free, null for paid
  template    Program  @relation(fields: [templateId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
}

// Post-workout check-in — one per session, optional.
// sleep/mood/hydration/stress are 1-5 scales.
// Future: AI reads this alongside LoggedSet data for recommendations.
model Bundle {
  id              String    @id @default(cuid())
  coachId         String
  coach           Coach     @relation(fields: [coachId], references: [id])
  name            String
  description     String?
  currency        String    @default("KWD")
  discountFlat    Decimal?
  discountPercent Decimal?
  discountEndsAt  DateTime?
  createdAt       DateTime  @default(now())

  items     BundleItem[]
  purchases BundlePurchase[]
}

model BundleItem {
  id         String  @id @default(cuid())
  bundleId   String
  bundle     Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  templateId String
  template   Program @relation(fields: [templateId], references: [id])

  @@unique([bundleId, templateId])
}

model BundlePurchase {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      Bundle   @relation(fields: [bundleId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  purchasedAt DateTime @default(now())
  pricePaid   Decimal
  currency    String
}

model CheckIn {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id])
  date      DateTime @default(now())
  sleep     Int?     // 1-5
  mood      Int?     // 1-5
  hydration Int?     // 1-5
  stress    Int?     // 1-5
  notes     String?
}
